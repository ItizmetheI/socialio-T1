# VITE_SHOW_CLIENT_PORTAL: Feature flag to show/hide the Client Login button
VITE_SHOW_CLIENT_PORTAL=true

# VITE_WEB3FORMS_KEY: Free access key from https://web3forms.com (no account/password needed,
# just an email to receive the key). Powers the Contact form and newsletter signups.
# Leave blank and those forms will show a fake "success" state without actually sending anything.
VITE_WEB3FORMS_KEY=

